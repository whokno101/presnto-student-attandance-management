# Server configuration
PORT=5001
NODE_ENV=development

# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/university-attendance
# No MongoDB installed? MONGO_URI=memory runs a local one (data in server/.data)
# Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/university-attendance
MONGO_URI=mongodb://127.0.0.1:27017/university-attendance

# JWT
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Client (Vite) configuration
VITE_API_URL=/api
